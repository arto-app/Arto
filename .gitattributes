# Images referenced from Markdown are inlined byte-for-byte as base64 data
# URLs, so a checkout that rewrites their line endings changes the rendered
# HTML. SVG is the only image format git would treat as text; keep it out of
# the conversion so every platform renders the same bytes.
*.svg -text

# Generated schemas are compared byte-for-byte against what the types
# produce, and serde_json writes LF; a CRLF checkout would fail that test on
# Windows without anything having changed.
schemas/*.json text eol=lf
