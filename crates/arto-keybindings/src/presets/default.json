    {
      "key": "Cmd+k",
      "action": "palette.open"
    },
    {
      "key": "Cmd+j",
      "action": "contents.toggle"
    },
    {
      "key": "Ctrl+ArrowLeft",
      "action": "focus.places"
    }
  ],
  "content": [
    {
      "key": "Enter",
      "action": "content.open_viewer"
    },
    {
      "key": "Alt+ArrowDown",
      "action": "content.next"
    },
    {
      "key": "Alt+ArrowUp",
      "action": "content.prev"
    },
    {
      "key": "Alt+Shift+ArrowDown",
      "action": "content.next_heading"
    },
    {
      "key": "Alt+Shift+ArrowUp",
      "action": "content.prev_heading"
    },
    {
      "key": "Ctrl+ArrowLeft",
      "action": "focus.places"
    }
  ],
  "sidebar": [
    {
      "key": "ArrowDown",
      "action": "cursor.down"
    },
    {
      "key": "ArrowUp",
      "action": "cursor.up"
    },
    {
      "key": "ArrowRight",
      "action": "cursor.open"
    },
    {
      "key": "Enter",
      "action": "cursor.enter"
    },
    {
      "key": "ArrowLeft",
      "action": "cursor.collapse"
    },
    {
      "key": "Backspace",
      "action": "directory.parent"
    },
    {
      "key": "Ctrl+ArrowRight",
      "action": "focus.content"
    },
    {
      "key": "Ctrl+ArrowDown",
      "action": "sidebar.face_next"
    },
    {
      "key": "Ctrl+ArrowUp",
      "action": "sidebar.face_prev"
    },
    {
      "key": "Ctrl+ArrowLeft",
      "action": "focus.places"
    }
  ],
  "search": [
    {
      "key": "Tab",
      "action": "search.next"
    },
    {
      "key": "Shift+Tab",
      "action": "search.prev"
    },
    {
      "key": "Enter",
      "action": "search.pin_current"
    },
    {
      "key": "Escape",
      "action": "search.clear"
    }
  ],
  "palette": [
    {
      "key": "ArrowDown",
      "action": "palette.next"
    },
    {
      "key": "ArrowUp",
      "action": "palette.prev"
    },
    {
      "key": "Tab",
      "action": "palette.next"
    },
    {
      "key": "Shift+Tab",
      "action": "palette.prev"
    },
    {
      "key": "Enter",
      "action": "palette.confirm"
    },
    {
      "key": "Escape",
      "action": "palette.close"
    }
  ],
  "contents": [
    {
      "key": "ArrowDown",
      "action": "contents.next"
    },
    {
      "key": "ArrowUp",
      "action": "contents.prev"
    },
    {
      "key": "Tab",
      "action": "contents.next"
    },
    {
      "key": "Shift+Tab",
      "action": "contents.prev"
    },
    {
      "key": "Enter",
      "action": "contents.confirm"
    },
    {
      "key": "Escape",
      "action": "contents.close"
    }
  ]
}
