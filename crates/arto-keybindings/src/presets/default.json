{
  "$schema": "./preset.schema.json",
  "menuShortcuts": [
    {
      "key": "Cmd+n",
      "action": "window.new"
    },
    {
      "key": "Cmd+Shift+n",
      "action": "window.duplicate"
    },
    {
      "key": "Cmd+t",
      "action": "window.new_document"
    },
    {
      "key": "Cmd+w",
      "action": "window.close"
    },
    {
      "key": "Cmd+o",
      "action": "file.open"
    },
    {
      "key": "Cmd+Shift+o",
      "action": "file.open_directory"
    },
    {
      "key": "Cmd+Shift+r",
      "action": "file.reveal_in_finder"
    },
    {
      "key": "Cmd+p",
      "action": "file.print"
    },
    {
      "key": "Cmd+Comma",
      "action": "file.preferences"
    },
    {
      "key": "Cmd+f",
      "action": "search.open"
    },
    {
      "key": "Cmd+g",
      "action": "search.next"
    },
    {
      "key": "Cmd+Shift+g",
      "action": "search.prev"
    },
    {
      "key": "Cmd+b",
      "action": "window.toggle_sidebar"
    },
    {
      "key": "Cmd+0",
      "action": "zoom.reset"
    },
    {
      "key": "Cmd+Equal",
      "action": "zoom.in"
    },
    {
      "key": "Cmd+Minus",
      "action": "zoom.out"
    },
    {
      "key": "Cmd+BracketLeft",
      "action": "history.back"
    },
    {
      "key": "Cmd+BracketRight",
      "action": "history.forward"
    }
  ],
  "global": [
    {
      "key": "Cmd+r",
      "action": "window.reload"
    },
    {
      "key": "Cmd+Enter",
      "action": "file.open_link"
    },
    {
      "key": "Cmd+Shift+Enter",
      "action": "file.open_link_in_new_window"
    },
    {
      "key": "Cmd+d",
      "action": "file.toggle_bookmark"
    },
    {
      "key": "Cmd+Slash",
