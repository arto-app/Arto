    },
    {
      "key": "F1",
      "action": "help.show_keyboard_shortcuts"
    },
    {
      "key": "ArrowDown",
      "action": "scroll.down"
    },
    {
      "key": "ArrowUp",
      "action": "scroll.up"
    },
    {
      "key": "PageDown",
      "action": "scroll.page_down"
    },
    {
      "key": "PageUp",
      "action": "scroll.page_up"
    },
    {
      "key": "Home",
      "action": "scroll.top"
    },
    {
      "key": "End",
      "action": "scroll.bottom"
    },
    {
      "key": "Escape",
      "action": "cancel"
    },
    {
      "key": "Cmd+1",
      "action": "sidebar.face_places"
    },
    {
      "key": "Cmd+2",
      "action": "sidebar.face_recent"
    },
    {
      "key": "Cmd+3",
      "action": "sidebar.face_starred"
