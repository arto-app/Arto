{
  "name": "arto-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --include-workspace-root --parallel run watch",
    "watch": "vite build --mode development --watch --minify false",
    "build": "pnpm --filter @arto-app/markdown run build && vite build --minify",
    "fmt": "pnpm --filter @arto-app/markdown run fmt && oxfmt --write \"**/*.{ts,tsx,js,jsx,css}\" \"!markdown/**\"",
    "fmt:check": "pnpm --filter @arto-app/markdown run fmt:check && oxfmt --check \"**/*.{ts,tsx,js,jsx,css}\" \"!markdown/**\"",
    "check": "pnpm --filter @arto-app/markdown run check && oxlint --ignore-pattern \"markdown/**\" && tsc --noEmit",
    "test": "pnpm --filter @arto-app/markdown run test && vitest run"
  },
  "dependencies": {
    "@arto-app/markdown": "workspace:*",
    "@primer/css": "^22.3.3",
    "@primer/primitives": "^11.10.0",
    "@types/node": "^26.6.6",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.19.1",
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@tabler/icons": "^3.52.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.4"
}
