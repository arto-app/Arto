{
  "name": "arto-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch --minify false",
    "build": "vite build --minify",
    "fmt": "oxfmt --write \"**/*.{ts,tsx,js,jsx,css}\"",
    "fmt:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,css}\"",
    "check": "oxlint && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@primer/css": "^22.3.3",
    "@primer/primitives": "^11.10.0",
    "@types/node": "^26.6.6",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.19.1",
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@tabler/icons": "^3.50.0",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.4"
}
